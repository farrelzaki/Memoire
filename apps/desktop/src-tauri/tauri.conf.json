{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Memoire",
  "version": "0.1.0",
  "identifier": "com.memoire.app",
  "build": {
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "pnpm --filter @memoire/web dev",
    "frontendDist": "http://localhost:3000"
  },
  "app": {
    "windows": [
      {
        "title": "Memoire",
        "width": 1280,
        "height": 800,
        "minWidth": 720,
        "minHeight": 480,
        "url": "http://localhost:3000"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis", "deb", "appimage", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "active": true,
      "endpoints": [
        "https://updates.memoire.app/{{target}}/{{arch}}/{{current_version}}"
      ],
      "dialog": true,
      "pubkey": "REPLACE_WITH_GENERATED_TAURI_UPDATER_PUBKEY"
    }
  }
}
