# Copy this file to `.env` and adjust as needed.
PORT=3001

# PostgreSQL (matches docker-compose.yml — host port 5433 to avoid the native
# Laragon PostgreSQL on 5432)
DATABASE_URL=postgresql://memoire:memoire@localhost:5433/memoire

# Next.js origin allowed for CORS during local dev
WEB_ORIGIN=http://localhost:3000

# Object storage (MinIO local / S3-compatible) — wired in the media sprint (§28)
# S3_ENDPOINT=http://localhost:9000
# S3_REGION=us-east-1
# S3_ACCESS_KEY=memoire
# S3_SECRET_KEY=memoire123
# S3_BUCKET=memoire
