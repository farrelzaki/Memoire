{
  "name": "memoire",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.24.0",
  "description": "Memoire — personal knowledge workspace (Notion-inspired, single-user)",
  "scripts": {
    "postinstall": "pnpm --filter @memoire/validation run build",
    "dev": "pnpm --parallel --filter @memoire/web --filter @memoire/api run dev",
    "build": "pnpm -r --filter !@memoire/desktop run build",
    "lint": "pnpm -r --filter !@memoire/desktop run lint",
    "typecheck": "pnpm -r --filter !@memoire/desktop run typecheck",
    "test": "pnpm -r --filter !@memoire/desktop run test",
    "test:watch": "pnpm -r --filter !@memoire/desktop run test:watch",
    "test:e2e": "pnpm --filter @memoire/web run test:e2e",
    "db:migrate": "pnpm --filter @memoire/api run db:migrate",
    "db:generate": "pnpm --filter @memoire/api run db:generate",
    "db:studio": "pnpm --filter @memoire/api run db:studio",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "desktop:dev": "pnpm --filter @memoire/desktop run dev",
    "desktop:build": "pnpm --filter @memoire/desktop run build"
  },
  "engines": {
    "node": ">=20"
  }
}
